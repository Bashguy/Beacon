{
  "expo": {
    "name": "",
    "slug": "beacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon2.png",
    "scheme": "beacon",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon2.png",
      "resizeMode": "contain",
      "backgroundColor": "#252D1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lsvrionis.beacon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#252D1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Andada_Pro,Miss_Fajardose/Andada_Pro/Andada_Pro/static/Andada_Pro-Regular.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#252D1F",
          "dark": {
            "backgroundColor": "#252D1F"
          }
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "1062106947199-vr4p1i164e9ofkk3ofl7oc1dkols03b3.apps.googleusercontent.com",
      "googleIosClientId": "1062106947199-g09rkihu0ijucf59nh7vd40m1uuoe4j9.apps.googleusercontent.com",
      "googleAndroidClientId": "1062106947199-hc2a45gk2gh2mnu5i7h1nkctvu04edhe.apps.googleusercontent.com",
      "googleMapsKey": "AIzaSyCAh6DlzEVFqQ0DZsa3x1rXdDpTxIZxODQ",
      "router": {},
      "eas": {
        "projectId": "9da60a11-0f10-4fef-a05d-ddcb655ca16e"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
